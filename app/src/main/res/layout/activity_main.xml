<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="BYD Password Auto"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:text="VERSIÓN 1.3 — DIAGNÓSTICO"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/status"
            android:layout_marginTop="14dp"
            android:padding="12dp"
            android:text="Cargando diagnóstico…"
            android:textSize="16sp"
            android:textIsSelectable="true"
            android:background="#EEEEEE"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/refresh"
            android:layout_marginTop="10dp"
            android:text="Actualizar diagnóstico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/learn_byd"
            android:layout_marginTop="10dp"
            android:text="Aprender mi app BYD"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_marginTop="6dp"
            android:text="Pulsa ‘Aprender mi app BYD’ y abre inmediatamente la app oficial BYD. La aplicación guardará localmente el paquete real de tu versión de BYD."
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/password"
            android:layout_marginTop="22dp"
            android:hint="Contraseña de operación (6 dígitos)"
            android:inputType="numberPassword"
            android:maxLength="6"
            android:importantForAutofill="no"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/save"
            android:layout_marginTop="10dp"
            android:text="Guardar contraseña"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Switch
            android:id="@+id/automation_switch"
            android:layout_marginTop="18dp"
            android:text="Activar automatización"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/accessibility"
            android:layout_marginTop="14dp"
            android:text="Abrir configuración de Accesibilidad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_marginTop="18dp"
            android:text="La contraseña guardada no se vuelve a mostrar. La aplicación no necesita Internet ni se comunica con servidores externos."
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</ScrollView>
