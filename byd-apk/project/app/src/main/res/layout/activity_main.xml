<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
  <LinearLayout android:orientation="vertical" android:padding="24dp" android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView android:text="BYD Password Auto" android:textSize="26sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:layout_marginTop="12dp" android:text="Guarda localmente la contraseña de operación y automatiza su introducción únicamente cuando BYD AUTO muestre la pantalla de contraseña." android:layout_width="match_parent" android:layout_height="wrap_content" />
    <EditText android:id="@+id/password" android:layout_marginTop="24dp" android:hint="Contraseña de operación (6 dígitos)" android:inputType="numberPassword" android:maxLength="6" android:importantForAutofill="no" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <Button android:id="@+id/save" android:layout_marginTop="12dp" android:text="Guardar contraseña" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <Switch android:id="@+id/automation_switch" android:layout_marginTop="20dp" android:text="Activar automatización" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <Button android:id="@+id/accessibility" android:layout_marginTop="16dp" android:text="Abrir configuración de Accesibilidad" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/status" android:layout_marginTop="20dp" android:text="Estado" android:textSize="16sp" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:layout_marginTop="20dp" android:text="La contraseña guardada no se vuelve a mostrar. La aplicación no necesita Internet ni se comunica con servidores externos." android:layout_width="match_parent" android:layout_height="wrap_content" />
  </LinearLayout>
</ScrollView>
